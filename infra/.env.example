# Production stack settings (copy to infra/.env; never commit the real file).

# Deployments: https://<id>.<DEPLOYMENT_DOMAIN>, dashboard + API: https://app.<DEPLOYMENT_DOMAIN>
DEPLOYMENT_DOMAIN=example.com

# Let's Encrypt account / expiry notices
ACME_EMAIL=you@example.com

# Host folder for builds, published sites and route files (created by setup)
FORGEDEPLOY_DATA_DIR=/srv/forgedeploy

# Redis password, e.g.: openssl rand -hex 32
REDIS_PASSWORD=
