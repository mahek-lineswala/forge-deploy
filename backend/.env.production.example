# Backend production secrets (copy to backend/.env.production; never commit).
# Domain-dependent URLs, Redis and proxy settings are set in infra/docker-compose.prod.yml.

DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/forgedeploy?retryWrites=true&w=majority
# openssl rand -hex 48
JWT_SECRET=
# openssl rand -hex 32  (must equal the worker's ENCRYPTION_KEY)
ENCRYPTION_KEY=
# GitHub OAuth app: callback URL https://app.<DEPLOYMENT_DOMAIN>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
