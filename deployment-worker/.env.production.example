# Worker production settings (copy to deployment-worker/.env.production; never commit).
# Paths, URLs, Redis and Nginx settings are set in infra/docker-compose.prod.yml.

DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/forgedeploy?retryWrites=true&w=majority
MONGODB_DATABASE=forgedeploy
# Must equal the backend's ENCRYPTION_KEY
ENCRYPTION_KEY=

MAX_CONCURRENT_DEPLOYMENTS=2
BUILD_CPUS=2
BUILD_MEMORY=4g
RUNTIME_CONTAINER_MEMORY=512m
RUNTIME_CONTAINER_CPUS=1
DEPLOYMENT_RETENTION_DAYS=7
