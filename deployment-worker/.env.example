NODE_ENV=development

REDIS_URL=redis://127.0.0.1:6379

DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority

MONGODB_DATABASE=forgedeploy

TEMP_DIR=./temp
LOG_DIR=./logs

MAX_CONCURRENT_DEPLOYMENTS=2
ENCRYPTION_KEY=
DEPLOYMENTS_DIR=./deployments
# Deployments are served at http://<deploymentId>.localhost:8080
DEPLOYMENT_BASE_URL=http://localhost:8080
# Set to false to publish without checking Nginx serves the deployment
HEALTH_CHECK_ENABLED=true
# Build sandbox: run builds as uid:gid ("root" only if bind-mount writes fail)
BUILD_USER=1000:1000
# true = npm install has network, the build script runs with --network none
BUILD_NETWORK_ISOLATION=true
