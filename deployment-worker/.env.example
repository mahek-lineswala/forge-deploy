# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
MAX_CONCURRENT_DEPLOYMENTS=2

# ── Shared with the backend (must match backend/.env) ─────
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
MONGODB_DATABASE=forgedeploy
ENCRYPTION_KEY=

# ── Local folders ─────────────────────────────────────────
TEMP_DIR=./temp
LOG_DIR=./logs
DEPLOYMENTS_DIR=./deployments

# ── Build sandbox ─────────────────────────────────────────
# Run builds as uid:gid ("root" only if volume writes fail)
BUILD_USER=1000:1000
# Install/build container resources (Next.js builds are CPU-heavy)
BUILD_CPUS=2
BUILD_MEMORY=4g
# true = install has network, the build script runs with --network none
BUILD_NETWORK_ISOLATION=true
# Shared dependency cache volume reused by every build
BUILD_CACHE_VOLUME=forgedeploy-build-cache

# ── Hosting ───────────────────────────────────────────────
# Deployments are served at http://<id>.localhost:8080
DEPLOYMENT_BASE_URL=http://localhost:8080
# false = publish without checking Nginx serves the deployment
HEALTH_CHECK_ENABLED=true
NGINX_CONTAINER_NAME=forgedeploy-nginx
RUNTIME_NGINX_DIR=./runtime-nginx

# ── Runtime containers ────────────────────────────────────
RUNTIME_DOCKER_NETWORK=forgedeploy-network
RUNTIME_CONTAINER_MEMORY=512m
RUNTIME_CONTAINER_CPUS=1
